<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>X Redesign — Checkpoint 3</title>
<style>
  /* ── Reset & Base ─────────────────────────────── */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #0a0a0a;
    --bg-card: rgba(255,255,255,0.04);
    --border: rgba(255,255,255,0.08);
    --text: #e8e8e8;
    --text-dim: #888;
    --accent: #d4d4d4;
    --metallic: linear-gradient(135deg, #fff 0%, #999 40%, #fff 60%, #777 100%);
  }

  html {
    scroll-snap-type: y mandatory;
    overflow-y: scroll;
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', 'SF Pro Display', -apple-system, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Slide Base ───────────────────────────────── */
  .slide {
    min-height: 100vh;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 10%;
    position: relative;
    overflow: hidden;
  }

  /* ── Scroll Animations ────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1 { transition-delay: 0.15s; }
  .reveal-delay-2 { transition-delay: 0.30s; }
  .reveal-delay-3 { transition-delay: 0.45s; }
  .reveal-delay-4 { transition-delay: 0.60s; }
  .reveal-delay-5 { transition-delay: 0.75s; }

  /* ── Typography ───────────────────────────────── */
  .slide-label {
    font-size: 1.5rem;
    letter-spacing: 6px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 24px;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .slide-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 700;
    background: linear-gradient(90deg, #fff 0%, #999 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 20px;
    text-align: center;
  }
  .slide-subtitle {
    font-size: 1.8rem;
    color: #ffffff;
    max-width: 80%;
    text-align: center;
    line-height: 1.7;
    font-weight: 400;
  }

  /* ═══════════════════════════════════════════════
     SLIDE 1 — HERO
     ═══════════════════════════════════════════════ */
  .hero {
    background: radial-gradient(ellipse at 50% 40%, #151520 0%, #0a0a0c 70%);
    overflow: hidden;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
    position: relative;
    text-align: center;
  }
  .x-logo {
    font-size: clamp(10rem, 18vw, 14rem);
    font-weight: 900;
    line-height: 1;
    font-family: 'Inter', Arial, sans-serif;
    background: linear-gradient(180deg, #a0a0a8 0%, #78787e 50%, #606068 100%);
    background-size: 100% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: hero-metal 6s ease-in-out infinite;
    margin-bottom: 20px;
  }
  @keyframes hero-metal {
    0%, 100% { background-position: 0% 0%; }
    50% { background-position: 0% 100%; }
  }
  .hero h1 {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 700;
    color: rgba(255,255,255,0.85);
    letter-spacing: 1px;
    margin-bottom: 14px;
  }
  .hero .checkpoint {
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 10px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
  }

  /* Drifting Stars */
  .star-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    background: white;
    border-radius: 50%;
    opacity: 0;
    animation: drift var(--drift-dur) linear infinite, star-fade var(--fade-dur) ease-in-out infinite;
    animation-delay: var(--delay);
  }
  @keyframes drift {
    from { transform: translateY(0); }
    to { transform: translateY(-110vh); }
  }
  @keyframes star-fade {
    0%, 100% { opacity: 0; }
    20%, 80% { opacity: var(--star-opacity); }
  }

  /* ═══════════════════════════════════════════════
     SLIDE 2 — TEAM
     ═══════════════════════════════════════════════ */
  .team-rows {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 60px;
    margin-top: 48px;
    width: 90%;
    max-width: 1200px;
  }
  .team-row-top, .team-row-bottom {
    display: flex;
    justify-content: center;
    gap: 72px;
  }
  .team-card {
    text-align: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    width: 160px;
  }
  .team-card:hover {
    transform: translateY(-4px);
  }
  .team-avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: linear-gradient(135deg, #333, #555);
    margin: 0 auto 18px;
    overflow: hidden;
    border: 2px solid rgba(255,255,255,0.1);
  }
  .team-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .team-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    background: linear-gradient(90deg, #fff 0%, #999 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.3;
  }

  /* ═══════════════════════════════════════════════
     SLIDE 3 — WHAT HAVE WE DONE
     ═══════════════════════════════════════════════ */
  .phases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    width: 80%;
    max-width: 1100px;
    margin-top: 48px;
  }
  .phase-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px 28px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .phase-number {
    font-size: 3.5rem;
    font-weight: 800;
    background: var(--metallic);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 16px;
  }
  .phase-card h3 { font-size: 1.5rem; margin-bottom: 10px; }
  .phase-card p { font-size: 1.5rem; color: var(--text-dim); line-height: 1.5; }
  .back-note {
    margin-top: 40px;
    font-style: italic;
    color: var(--text-dim);
    font-size: 1.5rem;
  }

  /* ═══════════════════════════════════════════════
     SLIDE 4 — OUR PROBLEMS
     ═══════════════════════════════════════════════ */
  .problems-list {
    list-style: none;
    counter-reset: problems;
    margin-top: 48px;
    text-align: left;
    max-width: 800px;
    width: 80%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .problems-list li {
    counter-increment: problems;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text);
    padding: 32px 40px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .problems-list li::before {
    content: "0" counter(problems);
    font-size: 2.2rem;
    font-weight: 800;
    background: var(--metallic);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════
     PHONE MOCKUPS (kept for reuse)
     ═══════════════════════════════════════════════ */
  .mockups-row {
    display: flex;
    gap: 48px;
    margin-top: 48px;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    width: 90%;
    max-width: 1200px;
  }
  .phone-mockup {
    position: relative;
    flex-shrink: 0;
  }
  .phone-frame {
    width: 280px;
    height: 580px;
    border-radius: 36px;
    border: 3px solid rgba(255,255,255,0.15);
    overflow: hidden;
    background: #000;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .phone-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .phone-label {
    text-align: center;
    margin-top: 16px;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
  }

  /* Hand-drawn annotation circles */
  .annotation-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }
  .annotation-layer svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hand-circle {
    fill: none;
    stroke: #ff4444;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    opacity: 0;
  }
  .hand-line {
    fill: none;
    stroke: #ff4444;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
  }
  .phone-mockup.visible .hand-circle,
  .phone-mockup.visible .hand-line {
    opacity: 1;
    animation: draw-stroke 1.2s ease forwards;
  }
  .phone-mockup.visible .hand-circle.delay-1,
  .phone-mockup.visible .hand-line.delay-1 { animation-delay: 0.8s; }
  .phone-mockup.visible .hand-circle.delay-2,
  .phone-mockup.visible .hand-line.delay-2 { animation-delay: 1.6s; }

  @keyframes draw-stroke {
    to { stroke-dashoffset: 0; }
  }

  /* Annotation callout labels */
  .callout {
    position: absolute;
    font-size: 0.85rem;
    color: #ff4444;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    line-height: 1.3;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .phone-mockup.visible .callout { opacity: 1; transform: translateY(0); }
  .phone-mockup.visible .callout.delay-1 { transition-delay: 1.2s; }
  .phone-mockup.visible .callout.delay-2 { transition-delay: 2.0s; }

  /* ═══════════════════════════════════════════════
     SLIDE 5 — INFORMATION ARCHITECTURE
     ═══════════════════════════════════════════════ */
  .ia-diagram {
    width: 90%;
    max-width: 1100px;
    margin-top: 48px;
    padding: 48px 40px;
  }
  .ia-svg {
    width: 100%;
    height: auto;
  }

  /* ═══════════════════════════════════════════════
     SLIDE 6 — USER RESEARCH
     ═══════════════════════════════════════════════ */
  .research-stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 80%;
    max-width: 1100px;
    margin-top: 48px;
  }
  .method-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 44px 40px;
    position: relative;
  }
  .method-badge {
    display: inline-block;
    font-size: 1.5rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 20px;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .method-card h3 { font-size: 1.75rem; margin-bottom: 14px; font-weight: 700; }
  .method-card p { font-size: 1.5rem; color: var(--text-dim); line-height: 1.6; }
  .method-stat {
    font-size: 3.5rem;
    font-weight: 800;
    background: var(--metallic);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 16px 0;
  }

  /* Interview card: left info + right issues */
  .interview-layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 40px;
    align-items: start;
  }
  .interview-issues {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .issue-item h4 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }
  .quote {
    font-style: italic;
    color: var(--accent);
    border-left: 3px solid rgba(255,255,255,0.15);
    padding-left: 20px;
    margin-top: 8px;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  /* ═══════════════════════════════════════════════
     SLIDES 7-10 — PERSONAS & JOURNEYS
     ═══════════════════════════════════════════════ */
  .persona-card-full {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 52px 48px;
    width: 80%;
    max-width: 1100px;
    backdrop-filter: blur(10px);
  }
  .persona-header {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .persona-avatar-lg {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, #333, #555);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    flex-shrink: 0;
  }
  .persona-meta h2 {
    font-size: 2.2rem;
    font-weight: 700;
    background: linear-gradient(90deg, #fff 0%, #999 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .persona-meta p { font-size: 1.5rem; color: var(--text-dim); }
  .persona-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }
  .persona-detail h4 {
    font-size: 1.5rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .persona-detail p { font-size: 1.5rem; color: var(--accent); line-height: 1.5; }

  /* ── Journey Graph — Emotional Curve (JSX Port) ── */
  .jg-wrap {
    width: 100%;
    max-width: 1060px;
    margin-top: 32px;
    position: relative;
  }
  .jg-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .jg-title { font-size: 1.4rem; font-weight: 700; color: var(--text); }
  .jg-legend { display: flex; gap: 20px; font-size: 0.8rem; color: #aaa; }
  .jg-legend span { display: flex; align-items: center; gap: 6px; }
  .jg-chart {
    position: relative;
    width: 1060px;
    max-width: 100%;
    height: 420px;
  }
  .jg-chart svg { position: absolute; inset: 0; overflow: visible; }
  /* Keyframes matching JSX exactly */
  @keyframes jg-expandRing {
    0%   { r: 10; opacity: 0.9; }
    100% { r: 44; opacity: 0; }
  }
  @keyframes jg-popDot {
    0%   { transform: scale(0); }
    60%  { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
  @keyframes jg-labelSlideIn {
    0%   { opacity: 0; transform: translate(-50%, 6px); }
    100% { opacity: 1; transform: translate(-50%, 0); }
  }
  @keyframes jg-labelRollUp {
    0%   { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, -22px); }
  }
  @keyframes jg-emojiBounce {
    0%   { opacity: 0; transform: translate(-50%, -18px) scale(0.5); }
    60%  { transform: translate(-50%, 4px) scale(1.15); opacity: 1; }
    100% { transform: translate(-50%, 0) scale(1); opacity: 1; }
  }
  @keyframes jg-badgePop {
    0%   { opacity: 0; transform: translate(-50%, 0) scale(0.7); }
    70%  { transform: translate(-50%, 0) scale(1.08); opacity: 1; }
    100% { transform: translate(-50%, 0) scale(1); opacity: 1; }
  }
  @keyframes jg-glowPulse {
    0%, 100% { filter: drop-shadow(0 0 5px currentColor); }
    50%      { filter: drop-shadow(0 0 14px currentColor); }
  }
  /* Overlay elements */
  .jg-overlay {
    position: absolute;
    pointer-events: none;
    white-space: nowrap;
    z-index: 10;
  }
  .jg-step-label {
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.3px;
  }
  .jg-emoji {
    font-size: 32px;
    line-height: 1;
  }
  .jg-badge {
    background: rgba(10,10,10,0.85);
    padding: 3px 11px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4px;
  }
  .jg-xlabel {
    position: absolute;
    font-size: 11px;
    color: #555;
    letter-spacing: 0.2px;
    transform: translateX(-50%);
  }

  /* ═══════════════════════════════════════════════
     SLIDE 11 — PROBLEMS
     ═══════════════════════════════════════════════ */
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    width: 80%;
    max-width: 1100px;
    margin-top: 48px;
  }
  .problem-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px 32px;
    position: relative;
    overflow: hidden;
  }
  .problem-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f87171, #fb923c, #facc15);
  }
  .problem-number {
    font-size: 3rem;
    font-weight: 900;
    color: rgba(255,255,255,0.06);
    position: absolute;
    top: 12px;
    right: 20px;
    font-family: 'SF Mono', monospace;
  }
  .problem-card h3 { font-size: 1.75rem; margin-bottom: 14px; font-weight: 700; }
  .problem-card p { font-size: 1.5rem; color: var(--text-dim); line-height: 1.6; }

  /* ═══════════════════════════════════════════════
     SLIDE 12 — NEXT STEPS
     ═══════════════════════════════════════════════ */
  .next-steps {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 80%;
    max-width: 800px;
    margin-top: 48px;
  }
  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 32px;
  }
  .step-num {
    font-size: 2rem;
    font-weight: 800;
    background: var(--metallic);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    flex-shrink: 0;
    line-height: 1;
    margin-top: 2px;
  }
  .step-item h3 { font-size: 1.75rem; margin-bottom: 6px; }
  .step-item p { font-size: 1.5rem; color: var(--text-dim); line-height: 1.5; }

  .footer-note {
    margin-top: 48px;
    font-size: 1.5rem;
    color: #444;
    letter-spacing: 3px;
    font-family: 'SF Mono', monospace;
  }

  /* ── Scrollbar ────────────────────────────────── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 768px) {
    .slide { padding: 40px 20px; }
    .persona-card-full { padding: 28px 20px; }
    .persona-header { flex-direction: column; text-align: center; }
    .mockups-row { gap: 32px; }
    .phone-frame { width: 240px; height: 500px; }
    .callout { display: none; }
  }
</style>
</head>
<body>

<!-- ═══════════════════════════════════════════════
     SLIDE 1 — HERO
     ═══════════════════════════════════════════════ -->
<section class="slide hero" id="hero">
  <div class="star-field" id="starfield"></div>
  <div class="hero-content">
    <div class="x-logo">X</div>
    <h1>X Team</h1>
    <p class="checkpoint">Checkpoint 3</p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SLIDE 2 — TEAM
     ═══════════════════════════════════════════════ -->
<section class="slide" id="team">
  <p class="slide-label reveal">Our Team</p>
  <h1 class="slide-title reveal reveal-delay-1">Meet the Team</h1>
  <div class="team-rows">
    <div class="team-row-top">
      <div class="team-card reveal reveal-delay-1">
        <div class="team-avatar"><img src="assets/daria.png" alt="Daria" style="object-position:center 20%;"></div>
        <h3>Daria Meshcheriakova</h3>
      </div>
      <div class="team-card reveal reveal-delay-2">
        <div class="team-avatar"><img src="assets/Megan_Photo.jpg" alt="Megan" style="object-position:center 15%;"></div>
        <h3>Megan Weiss</h3>
      </div>
      <div class="team-card reveal reveal-delay-3">
        <div class="team-avatar"><img src="assets/Amy_Photo.jpg" alt="Amy" style="object-position:center 15%;"></div>
        <h3>Amy Wang</h3>
      </div>
    </div>
