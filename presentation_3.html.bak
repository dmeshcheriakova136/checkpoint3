          <svg width="25" height="25" viewBox="0 0 25 25" fill="none"><circle cx="12.5" cy="12.5" r="9" stroke="#71767B" stroke-width="1.8"/><line x1="7" y1="12.5" x2="18" y2="12.5" stroke="#71767B" stroke-width="1.8" stroke-linecap="round" transform="rotate(45 12.5 12.5)"/></svg>
          <span style="font-size:10px;color:#71767B;font-family:Inter,sans-serif;">Grok</span>
        </div>
        <!-- Notifications -->
