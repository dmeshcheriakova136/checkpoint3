          <svg width="25" height="25" viewBox="0 0 25 25" fill="none"><rect x="3" y="6" width="19" height="13" rx="2" stroke="#71767B" stroke-width="1.8"/><polyline points="3,8 12.5,14 22,8" fill="none" stroke="#71767B" stroke-width="1.8" stroke-linejoin="round"/></svg>
          <span style="font-size:10px;color:#71767B;font-family:Inter,sans-serif;">Messages</span>
        </div>
      </div>
      <p id="lownav-badge-old" style="text-align:center;margin-top:20px;font-size:0.85rem;color:#e0a0a0;letter-spacing:1px;transition:opacity 0.5s ease;">5 items — Grok forced in</p>
    </div>

    <!-- Updated 4-item nav from Figma (hidden initially) -->
