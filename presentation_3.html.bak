     ═══════════════════════════════════════════════ -->
<section class="slide" id="info-arch-lownav">
  <p class="slide-subtitle reveal"><span style="color:#ffffff;margin-right:12px;">03</span>Low Navigation Bar</p>
  <div class="ia-diagram reveal reveal-delay-3" id="lownav-container" style="cursor:pointer;">
    <p class="ia-click-hint" id="lownav-hint" style="text-align:center;color:var(--text-dim);font-size:0.9rem;margin-bottom:16px;letter-spacing:2px;text-transform:uppercase;">Click to simplify</p>
    <!-- Original 5-item nav (shown first) -->
