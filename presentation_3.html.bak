      <div class="persona-detail">
        <h4>Bio</h4>
        <p>Normal Nora is a social human being, she likes to spend time with family and friends. Instagram is a great place for her, but it has a different use case when compared to 'X'. She feels that 'X' must allow friends to share textual ideas with each other and publicly, which is not a major selling point of Instagram.</p>
      </div>
      <div style="display:flex;gap:24px;width:100%;">
        <div class="persona-detail" style="flex:1;background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:24px 28px;">
          <h4>Pain Points</h4>
          <ul style="list-style:none;padding:0;margin:0;">
            <li style="font-size:1.1rem;color:var(--accent);line-height:1.5;padding:14px 0 14px 20px;position:relative;"><span style="position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--text-dim);display:block;"></span>The feed does not have a specific structure</li>
            <li style="font-size:1.1rem;color:var(--accent);line-height:1.5;padding:14px 0 14px 20px;position:relative;"><span style="position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--text-dim);display:block;"></span>Filtering in search lacks options</li>
            <li style="font-size:1.1rem;color:var(--accent);line-height:1.5;padding:14px 0 14px 20px;position:relative;"><span style="position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--text-dim);display:block;"></span>The messages tab is not very intuitive</li>
          </ul>
        </div>
        <div class="persona-detail" style="flex:1;background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:24px 28px;">
          <h4>Needs</h4>
          <ul style="list-style:none;padding:0;margin:0;">
            <li style="font-size:1.1rem;color:var(--accent);line-height:1.5;padding:14px 0 14px 20px;position:relative;"><span style="position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--text-dim);display:block;"></span>Customisable feed with options to include specific interests/profiles</li>
            <li style="font-size:1.1rem;color:var(--accent);line-height:1.5;padding:14px 0 14px 20px;position:relative;"><span style="position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--text-dim);display:block;"></span>Search filter updated with options to include time, popularity and other factors</li>
            <li style="font-size:1.1rem;color:var(--accent);line-height:1.5;padding:14px 0 14px 20px;position:relative;"><span style="position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--text-dim);display:block;"></span>A friends tab in the feed would be a useful addition</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SLIDE 10 — JOURNEY 2 (NORA) — Emotional Graph
     ═══════════════════════════════════════════════ -->
<section class="slide" id="journey2" style="display:none;">
  <p class="slide-label reveal">User Journey</p>
  <h1 class="slide-title reveal reveal-delay-1">Nora's Journey</h1>
  <div class="jg-wrap reveal reveal-delay-2" id="j2-graph">
    <div class="jg-header">
      <span class="jg-title">Emotional Journey</span>
      <div class="jg-legend">
        <span><span style="color:#4ade80;margin-right:4px;">&#9679;</span>Positive</span>
        <span><span style="color:#f87171;margin-right:4px;">&#9679;</span>Negative</span>
      </div>
    </div>
    <div class="jg-chart" id="j2-chart">
      <svg width="1060" height="420" id="j2-svg">
        <defs>
          <filter id="jg-glow2"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <line x1="80" y1="240" x2="1020" y2="240" stroke="#ffffff10" stroke-width="1" stroke-dasharray="4 8"/>
      </svg>
    </div>
  </div>
</section>

<!-- SLIDE 11 — 3 CORE PROBLEMS (REMOVED) -->

<!-- ═══════════════════════════════════════════════
     SLIDE 12 — NEXT STEPS
     ═══════════════════════════════════════════════ -->
<section class="slide" id="nextsteps">
  <p class="slide-label reveal">Looking Ahead</p>
  <h1 class="slide-title reveal reveal-delay-1">Next Steps</h1>
  <div class="next-steps">
    <div class="step-item reveal reveal-delay-2">
      <span class="step-num">01</span>
      <div>
        <h3>High Fidelity Wireframes</h3>
      </div>
    </div>
    <div class="step-item reveal reveal-delay-3">
      <span class="step-num">02</span>
      <div>
        <h3>Prototyping</h3>
      </div>
    </div>
    <div class="step-item reveal reveal-delay-4">
      <span class="step-num">03</span>
      <div>
        <h3>A/B Testing</h3>
      </div>
    </div>
  </div>
  <p class="footer-note reveal reveal-delay-5">X Team · Checkpoint 3 · DI Spring 2026</p>
</section>

<script>
  // ── Drifting Stars ──────────────────────────────
  (function createStars() {
    const container = document.getElementById('starfield');
    const count = 60;
    for (let i = 0; i < count; i++) {
      const s = document.createElement('div');
      s.classList.add('star');
      s.style.left = Math.random() * 100 + '%';
      s.style.top = (Math.random() * 120 + 10) + '%';
      s.style.setProperty('--drift-dur', (15 + Math.random() * 25) + 's');
      s.style.setProperty('--fade-dur', (3 + Math.random() * 5) + 's');
      s.style.setProperty('--delay', (Math.random() * 20) + 's');
      s.style.setProperty('--star-opacity', (0.2 + Math.random() * 0.6).toFixed(2));
      const size = (1 + Math.random() * 2.5) + 'px';
      s.style.width = size;
      s.style.height = size;
      container.appendChild(s);
    }
  })();

  // ── Scroll Reveal ──────────────────────────────
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // ── Phone mockup annotation trigger ───────────
  const phoneObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.phone-mockup').forEach(el => phoneObserver.observe(el));

  // ── Count-up number animation ───────────────
  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !entry.target.dataset.counted) {
        entry.target.dataset.counted = 'true';
        const target = +entry.target.dataset.target;
        const duration = 1800;
        const start = performance.now();
        const easeOut = t => 1 - Math.pow(1 - t, 3);
        function tick(now) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const value = Math.round(easeOut(progress) * target);
          entry.target.textContent = value;
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.count-up').forEach(el => countObserver.observe(el));

  // ── Journey Graph — JSX Port (Vanilla JS) ──────
  (function initJourneyGraph() {
    const PTS = [
      { x: 110,  y: 170, label: 'Opens App',      emotion: 'Hopeful',    emoji: '\u{1F60A}', color: '#4ade80', glow: 'rgba(74,222,128,0.4)' },
      { x: 320,  y: 225, label: 'Scrolls Feed',   emotion: 'Curious',    emoji: '\u{1F914}', color: '#38bdf8', glow: 'rgba(56,189,248,0.4)' },
      { x: 530,  y: 280, label: 'Sees Clutter',   emotion: 'Annoyed',    emoji: '\u{1F624}', color: '#fbbf24', glow: 'rgba(251,191,36,0.4)' },
      { x: 740,  y: 320, label: 'Searches Topic',  emotion: 'Frustrated', emoji: '\u{1F621}', color: '#f97316', glow: 'rgba(249,115,22,0.4)' },
      { x: 950,  y: 358, label: 'Gives Up',        emotion: 'Defeated',   emoji: '\u{1F62D}', color: '#f87171', glow: 'rgba(248,113,113,0.4)' },
    ];

    const SEQ = { DRAW_MS: 1400, SPARKLE_HOLD: 400, LABEL_IN: 400, LABEL_HOLD: 3000, LABEL_OUT: 500, EMOJI_IN: 500, BADGE_IN: 500, DONE_WAIT: 900 };

    function segPath(i) {
      const p0 = PTS[i], p1 = PTS[i + 1];
      const dx = (p1.x - p0.x) * 0.45;
      return 'M ' + p0.x + ' ' + p0.y + ' C ' + (p0.x + dx) + ' ' + p0.y + ' ' + (p1.x - dx) + ' ' + p1.y + ' ' + p1.x + ' ' + p1.y;
    }

    const graph = document.getElementById('j1-graph');
    const chart = document.getElementById('j1-chart');
    const svg = document.getElementById('j1-svg');
    if (!graph || !svg) return;

    const ns = 'http://www.w3.org/2000/svg';
    let started = false;

    // Add per-segment gradients
    const defs = svg.querySelector('defs');
    for (let i = 0; i < 4; i++) {
      const grad = document.createElementNS(ns, 'linearGradient');
      grad.id = 'seg' + i;
      grad.setAttribute('gradientUnits', 'userSpaceOnUse');
      grad.setAttribute('x1', PTS[i].x); grad.setAttribute('y1', PTS[i].y);
      grad.setAttribute('x2', PTS[i + 1].x); grad.setAttribute('y2', PTS[i + 1].y);
      const s1 = document.createElementNS(ns, 'stop'); s1.setAttribute('offset', '0%'); s1.setAttribute('stop-color', PTS[i].color);
      const s2 = document.createElementNS(ns, 'stop'); s2.setAttribute('offset', '100%'); s2.setAttribute('stop-color', PTS[i + 1].color);
      grad.appendChild(s1); grad.appendChild(s2);
      defs.appendChild(grad);
    }

    // Add x-axis labels
    PTS.forEach(pt => {
      const lbl = document.createElement('div');
      lbl.className = 'jg-xlabel';
      lbl.textContent = pt.label;
      lbl.style.left = pt.x + 'px';
      lbl.style.top = '392px';
      chart.appendChild(lbl);
    });

    // Segment drawing state
    const segProgs = [0, 0, 0, 0];
    const segGlowEls = [], segLineEls = [];
    for (let i = 0; i < 4; i++) {
      const d = segPath(i);
      // Glow layer
      const gp = document.createElementNS(ns, 'path');
      gp.setAttribute('d', d); gp.setAttribute('fill', 'none');
      gp.setAttribute('stroke', 'url(#seg' + i + ')');
      gp.setAttribute('stroke-width', '8'); gp.setAttribute('stroke-linecap', 'round');
      gp.setAttribute('opacity', '0.3'); gp.setAttribute('filter', 'url(#jg-glow)');
      gp.setAttribute('pathLength', '1'); gp.setAttribute('stroke-dasharray', '1'); gp.setAttribute('stroke-dashoffset', '1');
      svg.appendChild(gp); segGlowEls.push(gp);
      // Main line
      const lp = document.createElementNS(ns, 'path');
      lp.setAttribute('d', d); lp.setAttribute('fill', 'none');
      lp.setAttribute('stroke', 'url(#seg' + i + ')');
      lp.setAttribute('stroke-width', '3'); lp.setAttribute('stroke-linecap', 'round');
      lp.setAttribute('pathLength', '1'); lp.setAttribute('stroke-dasharray', '1'); lp.setAttribute('stroke-dashoffset', '1');
      svg.appendChild(lp); segLineEls.push(lp);
    }

    function delay(ms) { return new Promise(r => setTimeout(r, ms)); }

    function drawSeg(i) {
      return new Promise(resolve => {
        const start = performance.now();
        function tick(now) {
          let t = Math.min((now - start) / SEQ.DRAW_MS, 1);
          const e = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
          const off = String(1 - e);
          segGlowEls[i].setAttribute('stroke-dashoffset', off);
          segLineEls[i].setAttribute('stroke-dashoffset', off);
          if (t < 1) requestAnimationFrame(tick); else resolve();
        }
        requestAnimationFrame(tick);
      });
    }

    function showDot(pt) {
      // Sparkle rings
      for (let r = 0; r < 2; r++) {
        const ring = document.createElementNS(ns, 'circle');
        ring.setAttribute('cx', pt.x); ring.setAttribute('cy', pt.y); ring.setAttribute('r', '10');
        ring.setAttribute('fill', 'none'); ring.setAttribute('stroke', pt.color);
        ring.setAttribute('stroke-width', r === 0 ? '2' : '1.5'); ring.setAttribute('opacity', '0');
        ring.style.animation = 'jg-expandRing 1s ease-out ' + (r * 0.25) + 's forwards';
        svg.appendChild(ring);
        setTimeout(() => ring.remove(), 1500);
      }
      // Outer ring
      const outer = document.createElementNS(ns, 'circle');
      outer.setAttribute('cx', pt.x); outer.setAttribute('cy', pt.y); outer.setAttribute('r', '13');
      outer.setAttribute('fill', 'none'); outer.setAttribute('stroke', pt.color);
      outer.setAttribute('stroke-width', '1.5'); outer.setAttribute('opacity', '0.35');
      svg.appendChild(outer);
      // Dot
      const dot = document.createElementNS(ns, 'circle');
      dot.setAttribute('cx', pt.x); dot.setAttribute('cy', pt.y); dot.setAttribute('r', '8');
      dot.setAttribute('fill', pt.color); dot.setAttribute('filter', 'url(#jg-glow)');
      dot.style.transformOrigin = pt.x + 'px ' + pt.y + 'px';
      dot.style.animation = 'jg-popDot 0.4s ease-out forwards';
      svg.appendChild(dot);
    }

    function showLabel(pt) {
      const el = document.createElement('div');
      el.className = 'jg-overlay jg-step-label';
      el.textContent = pt.label;
      el.style.background = pt.color;
      el.style.left = pt.x + 'px';
      el.style.bottom = (420 - pt.y + 14) + 'px';
      el.style.animation = 'jg-labelSlideIn 0.4s ease forwards';
      chart.appendChild(el);
      return el;
    }

    function rollUpLabel(el) {
      el.style.animation = 'jg-labelRollUp 0.5s ease forwards';
      setTimeout(() => el.remove(), 500);
    }

    function showEmoji(pt) {
      const el = document.createElement('div');
      el.className = 'jg-overlay jg-emoji';
      el.textContent = pt.emoji;
      el.style.left = pt.x + 'px';
      el.style.bottom = (420 - pt.y + 50) + 'px';
      el.style.animation = 'jg-emojiBounce 0.55s cubic-bezier(.36,.07,.19,.97) forwards';
      chart.appendChild(el);
    }

    function showBadge(pt) {
      const el = document.createElement('div');
      el.className = 'jg-overlay jg-badge';
      el.textContent = pt.emotion;
      el.style.color = pt.color;
      el.style.borderWidth = '1.5px';
      el.style.borderStyle = 'solid';
      el.style.borderColor = pt.color;
      el.style.boxShadow = '0 0 10px ' + pt.glow;
      el.style.left = pt.x + 'px';
      el.style.bottom = (420 - pt.y + 14) + 'px';
      el.style.animation = 'jg-badgePop 0.45s ease forwards';
      chart.appendChild(el);
    }

    async function animatePoint(i) {
      const pt = PTS[i];
      showDot(pt);
      await delay(SEQ.SPARKLE_HOLD);
      const lbl = showLabel(pt);
      await delay(SEQ.LABEL_HOLD);
      rollUpLabel(lbl);
      await delay(SEQ.LABEL_OUT);
      showEmoji(pt);
      await delay(SEQ.EMOJI_IN);
      showBadge(pt);
      await delay(SEQ.BADGE_IN + SEQ.DONE_WAIT);
    }

    async function runAll() {
      await delay(600);
      for (let i = 0; i < PTS.length; i++) {
        await animatePoint(i);
        if (i < 4) await drawSeg(i);
      }
    }

    const jObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !started) {
          started = true;
          runAll();
        }
      });
    }, { threshold: 0.25 });
    jObs.observe(graph);
  })();

  // ── Nora's Journey Graph ──────────────────────
  (function initNorJourney() {
    const PTS = [
      { x: 110,  y: 190, label: 'Opens Feed',       emotion: 'Neutral',      emoji: '\u{1F610}', color: '#38bdf8', glow: 'rgba(56,189,248,0.4)' },
      { x: 320,  y: 240, label: 'Sees Random Posts', emotion: 'Confused',     emoji: '\u{1F615}', color: '#a78bfa', glow: 'rgba(167,139,250,0.4)' },
      { x: 530,  y: 290, label: 'Tries Search',      emotion: 'Annoyed',      emoji: '\u{1F624}', color: '#fbbf24', glow: 'rgba(251,191,36,0.4)' },
      { x: 740,  y: 330, label: 'Messages Tab',      emotion: 'Frustrated',   emoji: '\u{1F621}', color: '#f97316', glow: 'rgba(249,115,22,0.4)' },
      { x: 950,  y: 290, label: 'Switches to IG',    emotion: 'Relieved',     emoji: '\u{1F60C}', color: '#4ade80', glow: 'rgba(74,222,128,0.4)' },
    ];

    const SEQ = { DRAW_MS: 1400, SPARKLE_HOLD: 400, LABEL_IN: 400, LABEL_HOLD: 3000, LABEL_OUT: 500, EMOJI_IN: 500, BADGE_IN: 500, DONE_WAIT: 900 };

    function segPath(i) {
      const p0 = PTS[i], p1 = PTS[i + 1];
      const dx = (p1.x - p0.x) * 0.45;
      return 'M ' + p0.x + ' ' + p0.y + ' C ' + (p0.x + dx) + ' ' + p0.y + ' ' + (p1.x - dx) + ' ' + p1.y + ' ' + p1.x + ' ' + p1.y;
    }

    const graph = document.getElementById('j2-graph');
    const chart = document.getElementById('j2-chart');
    const svg = document.getElementById('j2-svg');
    if (!graph || !svg) return;

    const ns = 'http://www.w3.org/2000/svg';
    let started = false;

    const defs = svg.querySelector('defs');
    for (let i = 0; i < 4; i++) {
      const grad = document.createElementNS(ns, 'linearGradient');
      grad.id = 'n2seg' + i;
      grad.setAttribute('gradientUnits', 'userSpaceOnUse');
      grad.setAttribute('x1', PTS[i].x); grad.setAttribute('y1', PTS[i].y);
      grad.setAttribute('x2', PTS[i + 1].x); grad.setAttribute('y2', PTS[i + 1].y);
      const s1 = document.createElementNS(ns, 'stop'); s1.setAttribute('offset', '0%'); s1.setAttribute('stop-color', PTS[i].color);
      const s2 = document.createElementNS(ns, 'stop'); s2.setAttribute('offset', '100%'); s2.setAttribute('stop-color', PTS[i + 1].color);
      grad.appendChild(s1); grad.appendChild(s2);
      defs.appendChild(grad);
    }

    PTS.forEach(pt => {
      const lbl = document.createElement('div');
      lbl.className = 'jg-xlabel';
      lbl.textContent = pt.label;
      lbl.style.left = pt.x + 'px';
      lbl.style.top = '392px';
      chart.appendChild(lbl);
    });

    const segGlowEls = [], segLineEls = [];
    for (let i = 0; i < 4; i++) {
      const d = segPath(i);
      const gp = document.createElementNS(ns, 'path');
      gp.setAttribute('d', d); gp.setAttribute('fill', 'none');
      gp.setAttribute('stroke', 'url(#n2seg' + i + ')');
      gp.setAttribute('stroke-width', '8'); gp.setAttribute('stroke-linecap', 'round');
      gp.setAttribute('opacity', '0.3'); gp.setAttribute('filter', 'url(#jg-glow2)');
      gp.setAttribute('pathLength', '1'); gp.setAttribute('stroke-dasharray', '1'); gp.setAttribute('stroke-dashoffset', '1');
      svg.appendChild(gp); segGlowEls.push(gp);
      const lp = document.createElementNS(ns, 'path');
      lp.setAttribute('d', d); lp.setAttribute('fill', 'none');
      lp.setAttribute('stroke', 'url(#n2seg' + i + ')');
      lp.setAttribute('stroke-width', '3'); lp.setAttribute('stroke-linecap', 'round');
      lp.setAttribute('pathLength', '1'); lp.setAttribute('stroke-dasharray', '1'); lp.setAttribute('stroke-dashoffset', '1');
      svg.appendChild(lp); segLineEls.push(lp);
    }

    function delay(ms) { return new Promise(r => setTimeout(r, ms)); }

    function drawSeg(i) {
      return new Promise(resolve => {
        const start = performance.now();
        function tick(now) {
          let t = Math.min((now - start) / SEQ.DRAW_MS, 1);
          const e = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
          const off = String(1 - e);
          segGlowEls[i].setAttribute('stroke-dashoffset', off);
          segLineEls[i].setAttribute('stroke-dashoffset', off);
          if (t < 1) requestAnimationFrame(tick); else resolve();
        }
        requestAnimationFrame(tick);
      });
    }

    function showDot(pt) {
      for (let r = 0; r < 2; r++) {
        const ring = document.createElementNS(ns, 'circle');
        ring.setAttribute('cx', pt.x); ring.setAttribute('cy', pt.y); ring.setAttribute('r', '10');
        ring.setAttribute('fill', 'none'); ring.setAttribute('stroke', pt.color);
        ring.setAttribute('stroke-width', r === 0 ? '2' : '1.5'); ring.setAttribute('opacity', '0');
        ring.style.animation = 'jg-expandRing 1s ease-out ' + (r * 0.25) + 's forwards';
        svg.appendChild(ring);
        setTimeout(() => ring.remove(), 1500);
      }
      const outer = document.createElementNS(ns, 'circle');
      outer.setAttribute('cx', pt.x); outer.setAttribute('cy', pt.y); outer.setAttribute('r', '13');
      outer.setAttribute('fill', 'none'); outer.setAttribute('stroke', pt.color);
      outer.setAttribute('stroke-width', '1.5'); outer.setAttribute('opacity', '0.35');
      svg.appendChild(outer);
      const dot = document.createElementNS(ns, 'circle');
      dot.setAttribute('cx', pt.x); dot.setAttribute('cy', pt.y); dot.setAttribute('r', '8');
      dot.setAttribute('fill', pt.color); dot.setAttribute('filter', 'url(#jg-glow2)');
      dot.style.transformOrigin = pt.x + 'px ' + pt.y + 'px';
      dot.style.animation = 'jg-popDot 0.4s ease-out forwards';
      svg.appendChild(dot);
    }

    function showLabel(pt) {
      const el = document.createElement('div');
      el.className = 'jg-overlay jg-step-label';
      el.textContent = pt.label;
      el.style.background = pt.color;
      el.style.left = pt.x + 'px';
      el.style.bottom = (420 - pt.y + 14) + 'px';
      el.style.animation = 'jg-labelSlideIn 0.4s ease forwards';
      chart.appendChild(el);
      return el;
    }

    function rollUpLabel(el) {
      el.style.animation = 'jg-labelRollUp 0.5s ease forwards';
      setTimeout(() => el.remove(), 500);
    }

    function showEmoji(pt) {
      const el = document.createElement('div');
      el.className = 'jg-overlay jg-emoji';
      el.textContent = pt.emoji;
      el.style.left = pt.x + 'px';
      el.style.bottom = (420 - pt.y + 50) + 'px';
      el.style.animation = 'jg-emojiBounce 0.55s cubic-bezier(.36,.07,.19,.97) forwards';
      chart.appendChild(el);
    }

    function showBadge(pt) {
      const el = document.createElement('div');
      el.className = 'jg-overlay jg-badge';
      el.textContent = pt.emotion;
      el.style.color = pt.color;
      el.style.borderWidth = '1.5px';
      el.style.borderStyle = 'solid';
      el.style.borderColor = pt.color;
      el.style.boxShadow = '0 0 10px ' + pt.glow;
      el.style.left = pt.x + 'px';
      el.style.bottom = (420 - pt.y + 14) + 'px';
      el.style.animation = 'jg-badgePop 0.45s ease forwards';
      chart.appendChild(el);
    }

    async function animatePoint(i) {
      const pt = PTS[i];
      showDot(pt);
      await delay(SEQ.SPARKLE_HOLD);
      const lbl = showLabel(pt);
      await delay(SEQ.LABEL_HOLD);
      rollUpLabel(lbl);
      await delay(SEQ.LABEL_OUT);
      showEmoji(pt);
      await delay(SEQ.EMOJI_IN);
      showBadge(pt);
      await delay(SEQ.BADGE_IN + SEQ.DONE_WAIT);
    }

    async function runAll() {
      await delay(600);
      for (let i = 0; i < PTS.length; i++) {
        await animatePoint(i);
        if (i < 4) await drawSeg(i);
      }
    }

    const jObs2 = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !started) {
          started = true;
          runAll();
        }
      });
    }, { threshold: 0.25 });
    jObs2.observe(graph);
  })();

  // ── IA Diagram — Click to Simplify Animation ──────
  (function initIAAnimation() {
    const container = document.getElementById('ia-container');
    if (!container) return;
    let animated = false;

    container.addEventListener('click', function() {
      if (animated) return;
      animated = true;

      const hint = document.getElementById('ia-hint');
      if (hint) hint.style.opacity = '0';

      // Items to REMOVE: profile, lists, spaces, creator, grok-dl
      // Items to KEEP: bookmarks, communities, video, settings, grok(renamed from grok-dl? no - grok stays, grok-dl removed), premium, help
      // Wait — from Image #8 the final 7 are: Bookmarks, Communities, Video, Settings&Privacy, Grok, Help Center, Premium
      // Current 11: Profile, Premium, Video, Communities, Bookmarks, Lists, Spaces, Creator Studio, Download Grok, Settings&Privacy, Help Center
      // Remove: Profile, Lists, Spaces, Creator Studio, Download Grok (that's 5 removed → but we need to rename Download Grok?)
      // Actually keep Grok (not Download Grok). Let me remove: Profile, Lists, Spaces, Creator Studio, Download Grok = 5 removed. 11-5 = 6...
      // Image #8 has 7: Bookmarks, Communities, Video, Settings&Privacy, Grok, Help Center, Premium. That's 7.
      // From current 11 remove: Profile, Lists, Spaces, Creator Studio = 4 removed. Download Grok becomes just "Grok". 11-4 = 7. Yes!

      const removeItems = ['profile', 'lists', 'spaces', 'creator'];
      const renameItem = 'grok-dl'; // rename to "Grok"

      // Final positions for the 7 kept items (matching Image #8 layout)
      // Order: Bookmarks, Communities, Video, Settings&Privacy, Grok, Help Center, Premium
      const finalPositions = {
        'bookmarks':   { y: 60 },
        'communities': { y: 120 },
        'video':       { y: 200 },
        'settings':    { y: 280 },
        'grok-dl':     { y: 340 },
        'help':        { y: 400 },
        'premium':     { y: 460 }
      };

      // Step 1: Fade out removed items one by one
      let delay = 0;
      removeItems.forEach(function(item) {
        delay += 600;
        setTimeout(function() {
          var nodes = document.querySelectorAll('[data-item="' + item + '"]');
          nodes.forEach(function(n) { n.classList.add('removing'); });
        }, delay);
      });

      // Step 2: After removals, rearrange remaining items
      var rearrangeDelay = delay + 1000;
      setTimeout(function() {
        // Hide old badge, divider
        document.getElementById('ia-badge').style.opacity = '0';
        document.getElementById('ia-divider').style.opacity = '0';

        // Remove the removed nodes from DOM after fade
        removeItems.forEach(function(item) {
          var nodes = document.querySelectorAll('[data-item="' + item + '"]');
          nodes.forEach(function(n) { n.style.display = 'none'; });
        });

        // Animate remaining items to new positions
        Object.keys(finalPositions).forEach(function(item) {
          var targetY = finalPositions[item].y;
          var nodeGroup = document.querySelector('g.ia-node[data-item="' + item + '"]');
          var branchLine = document.querySelector('line.ia-line[data-item="' + item + '"]');

          if (nodeGroup) {
            var rect = nodeGroup.querySelector('rect');
            var text = nodeGroup.querySelector('text');
            var currentY = parseFloat(rect.getAttribute('y'));
            var diffY = targetY - currentY;
            nodeGroup.style.transition = 'transform 1s ease';
            nodeGroup.style.transform = 'translateY(' + diffY + 'px)';

            // Rename "Download Grok" → "Grok" and fix styling
            if (item === 'grok-dl') {
              text.textContent = 'Grok';
              rect.setAttribute('fill', '#2a3444');
              rect.setAttribute('stroke', '#4a5a6a');
              text.setAttribute('fill', '#c8d4e0');
              text.setAttribute('font-size', '12');
            }
          }

          if (branchLine) {
            branchLine.style.transition = 'all 1s ease';
            branchLine.setAttribute('y1', targetY);
            branchLine.setAttribute('y2', targetY);
          }
        });

        // Resize trunk line
        var trunk = document.getElementById('ia-trunk');
        trunk.style.transition = 'all 1s ease';
        trunk.setAttribute('y1', '60');
        trunk.setAttribute('y2', '460');

        // Update Hamburger & Open App / Home vertical center
        // They stay centered — the new midpoint of 60..460 is 260
        // Current position is y=330, move to y=240
        var fixedNodes = document.querySelectorAll('g.ia-node:not([data-item])');
        // actually let's keep them at 330, it looks fine

      }, rearrangeDelay);

      // Step 3: Show final badge
      setTimeout(function() {
        document.getElementById('ia-badge-final').setAttribute('opacity', '1');
      }, rearrangeDelay + 1200);
    });
  })();

  // ── Feeder IA — Click to Expand Tiers ──────
  (function initFeederIA() {
    var container = document.getElementById('feeder-container');
    if (!container) return;

    // Hide tiers 2+ initially
    var allTiers = container.querySelectorAll('.feeder-tier');
    allTiers.forEach(function(tier) {
      var t = parseInt(tier.getAttribute('data-tier'));
      if (t >= 2) {
        tier.style.opacity = '0';
        tier.style.transform = 'translateY(15px)';
        tier.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
      }
    });

    var currentTier = 1; // tiers 0-1 visible at start
    var maxTier = 6;

    container.addEventListener('click', function() {
      currentTier++;
      if (currentTier > maxTier + 1) return;

      // Hide the hint after first click
      var hint = document.getElementById('feeder-hint');
      if (hint) hint.style.opacity = '0';

      // Reveal the next tier
      allTiers.forEach(function(tier) {
        var t = parseInt(tier.getAttribute('data-tier'));
        if (t <= currentTier) {
          tier.style.opacity = '1';
          tier.style.transform = 'translateY(0)';
        }
      });
    });
  })();

  // ── Low Nav — Click to Simplify Animation ──────
  (function initLowNavIA() {
    var container = document.getElementById('lownav-container');
    if (!container) return;
    var animated = false;

    container.addEventListener('click', function() {
      if (animated) return;
      animated = true;

      var hint = document.getElementById('lownav-hint');
      if (hint) hint.style.opacity = '0';

      var removeItems = document.querySelectorAll('.lownav-remove-item');

      // Step 1: Fade out Grok
      setTimeout(function() {
        removeItems[0].style.opacity = '0';
        removeItems[0].style.transform = 'scale(0.8)';
      }, 500);

      // Step 2: Fade out Notifications
      setTimeout(function() {
        removeItems[1].style.opacity = '0';
        removeItems[1].style.transform = 'scale(0.8)';
      }, 1200);

      // Step 3: Fade out Messages
      setTimeout(function() {
        removeItems[2].style.opacity = '0';
        removeItems[2].style.transform = 'scale(0.8)';
      }, 1900);

      // Step 4: Swap to Figma design
      setTimeout(function() {
        var original = document.getElementById('lownav-original');
        original.style.transition = 'opacity 0.6s ease';
        original.style.opacity = '0';

        setTimeout(function() {
          original.style.height = '0';
          original.style.overflow = 'hidden';
          var updated = document.getElementById('lownav-updated');
          updated.style.opacity = '1';
          updated.style.height = 'auto';
        }, 600);
      }, 3000);
    });
  })();
</script>

</body>
</html>
