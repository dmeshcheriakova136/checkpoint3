<!-- ═══════════════════════════════════════════════
     SLIDE 5B — FEEDER INFORMATION ARCHITECTURE
     ═══════════════════════════════════════════════ -->
<section class="slide" id="info-arch-feeder">
  <p class="slide-subtitle reveal"><span style="color:#ffffff;margin-right:12px;">02</span>Feeder</p>
  <p class="reveal reveal-delay-1" style="font-size:1rem;color:var(--text-dim);font-style:italic;margin-top:12px;max-width:780px;text-align:center;line-height:1.6;">Feeder — A tool that lets users create custom presets for their own feeds by selecting topics, adjusting tone, selecting the users and generating personalized timelines.</p>
  <div class="ia-diagram reveal reveal-delay-3" id="feeder-container" style="cursor:pointer;">
    <p class="ia-click-hint" id="feeder-hint" style="text-align:center;color:var(--text-dim);font-size:0.9rem;margin-bottom:16px;letter-spacing:2px;text-transform:uppercase;">Click to expand</p>
    <svg id="feeder-svg" viewBox="0 0 900 620" xmlns="http://www.w3.org/2000/svg" class="ia-svg">

      <!-- ══ TIER 0: Side Nav Bar + Feeder ══ -->
      <g class="feeder-tier" data-tier="0">
        <!-- Side Nav Bar -->
        <rect x="370" y="10" width="160" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="450" y="33" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Side Nav Bar</text>
        <line x1="450" y1="46" x2="450" y2="64" stroke="#8a7a9a" stroke-width="2"/>
        <!-- Feeder -->
        <rect x="380" y="64" width="140" height="40" rx="20" fill="#2a2040" stroke="#8a7a9a" stroke-width="2"/>
        <text x="450" y="89" text-anchor="middle" fill="#e0d4f0" font-size="13" font-weight="700" font-family="Inter, sans-serif">Feeder</text>
        <line x1="450" y1="104" x2="450" y2="132" stroke="#8a7a9a" stroke-width="2"/>
        <line x1="250" y1="132" x2="650" y2="132" stroke="#8a7a9a" stroke-width="2"/>
        <line x1="250" y1="132" x2="250" y2="152" stroke="#8a7a9a" stroke-width="2"/>
        <line x1="650" y1="132" x2="650" y2="152" stroke="#8a7a9a" stroke-width="2"/>
      </g>

      <!-- ══ TIER 1: Feed Creator & Customise ══ -->
      <g class="feeder-tier" data-tier="1">
        <rect x="170" y="152" width="160" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="250" y="175" text-anchor="middle" fill="#c8b8d8" font-size="12" font-weight="600" font-family="Inter, sans-serif">Feed Creator</text>
        <rect x="570" y="152" width="160" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="650" y="175" text-anchor="middle" fill="#c8b8d8" font-size="12" font-weight="600" font-family="Inter, sans-serif">Customise</text>
        <!-- Feed Creator → Create, History -->
        <line x1="250" y1="188" x2="250" y2="214" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="130" y1="214" x2="370" y2="214" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="130" y1="214" x2="130" y2="236" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="370" y1="214" x2="370" y2="236" stroke="#8a7a9a" stroke-width="1.5"/>
        <!-- Customise → Feeds, Humour -->
        <line x1="650" y1="188" x2="650" y2="214" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="560" y1="214" x2="730" y2="214" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="560" y1="214" x2="560" y2="236" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="730" y1="214" x2="730" y2="236" stroke="#8a7a9a" stroke-width="1.5"/>
      </g>

      <!-- ══ TIER 2: Create, History, Feeds, Humour ══ -->
      <g class="feeder-tier" data-tier="2">
        <rect x="65" y="236" width="130" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="130" y="259" text-anchor="middle" fill="#c8b8d8" font-size="12" font-weight="600" font-family="Inter, sans-serif">Create</text>
        <rect x="305" y="236" width="130" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="370" y="259" text-anchor="middle" fill="#c8b8d8" font-size="12" font-weight="600" font-family="Inter, sans-serif">History</text>
        <rect x="495" y="236" width="130" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="560" y="259" text-anchor="middle" fill="#c8b8d8" font-size="12" font-weight="600" font-family="Inter, sans-serif">Feeds</text>
        <rect x="665" y="236" width="130" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="730" y="259" text-anchor="middle" fill="#c8b8d8" font-size="12" font-weight="600" font-family="Inter, sans-serif">Humour</text>
        <!-- Create → Text Box -->
        <line x1="130" y1="272" x2="130" y2="316" stroke="#8a7a9a" stroke-width="1.5"/>
        <!-- History → Revert, Delete -->
        <line x1="370" y1="272" x2="370" y2="296" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="310" y1="296" x2="440" y2="296" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="310" y1="296" x2="310" y2="316" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="440" y1="296" x2="440" y2="316" stroke="#8a7a9a" stroke-width="1.5"/>
        <!-- Humour → Formality -->
        <line x1="730" y1="272" x2="730" y2="316" stroke="#8a7a9a" stroke-width="1.5"/>
      </g>

      <!-- ══ TIER 3: Text Box, Revert, Delete, Formality ══ -->
      <g class="feeder-tier" data-tier="3">
        <rect x="65" y="316" width="130" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="130" y="339" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Text Box</text>
        <rect x="250" y="316" width="120" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="310" y="339" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Revert</text>
        <rect x="380" y="316" width="120" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="440" y="339" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Delete</text>
        <rect x="665" y="316" width="130" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="730" y="339" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Formality</text>
        <!-- Text Box → Topics, Freeform -->
        <line x1="130" y1="352" x2="130" y2="376" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="65" y1="376" x2="195" y2="376" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="65" y1="376" x2="65" y2="396" stroke="#8a7a9a" stroke-width="1.5"/>
        <line x1="195" y1="376" x2="195" y2="396" stroke="#8a7a9a" stroke-width="1.5"/>
        <!-- Revert → Edit -->
        <line x1="310" y1="352" x2="310" y2="396" stroke="#8a7a9a" stroke-width="1.5"/>
        <!-- Formality → Friends -->
        <line x1="730" y1="352" x2="730" y2="396" stroke="#8a7a9a" stroke-width="1.5"/>
      </g>

      <!-- ══ TIER 4: Topics, Freeform, Edit, Friends ══ -->
      <g class="feeder-tier" data-tier="4">
        <rect x="10" y="396" width="110" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="65" y="419" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Topics</text>
        <rect x="140" y="396" width="110" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="195" y="419" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Freeform</text>
        <rect x="265" y="396" width="90" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="310" y="419" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Edit</text>
        <rect x="675" y="396" width="110" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="730" y="419" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Friends</text>
        <!-- Topics → Add -->
        <line x1="65" y1="432" x2="65" y2="476" stroke="#8a7a9a" stroke-width="1.5"/>
        <!-- Edit → Past Text Box -->
        <line x1="310" y1="432" x2="310" y2="476" stroke="#8a7a9a" stroke-width="1.5"/>
      </g>

      <!-- ══ TIER 5: Add, Past Text Box ══ -->
      <g class="feeder-tier" data-tier="5">
        <rect x="10" y="476" width="110" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="65" y="499" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Add</text>
        <rect x="240" y="476" width="140" height="36" rx="18" fill="none" stroke="#8a7a9a" stroke-width="1.5"/>
        <text x="310" y="499" text-anchor="middle" fill="#c8b8d8" font-size="11" font-weight="600" font-family="Inter, sans-serif">Past Text Box</text>
