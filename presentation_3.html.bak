        <span style="font-size:12px;color:#a0d8b8;font-family:Inter,sans-serif;font-weight:600;letter-spacing:1px;">Profile</span>
      </div>
      <!-- Figma nav bar -->
      <div style="background:#000;border-radius:16px;overflow:hidden;border-top:0.667px solid #1E2939;padding:18px 36px 0;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
