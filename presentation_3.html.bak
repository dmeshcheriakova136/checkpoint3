     ═══════════════════════════════════════════════ -->
<section class="slide" id="overview">
  <p class="slide-label reveal">Overview</p>
  <h1 class="slide-title reveal reveal-delay-1">What Have We Done?</h1>
  <div class="phases">
    <div class="phase-card reveal reveal-delay-1">
      <div class="phase-number">01</div>
      <h3>High-Fidelity Wireframing</h3>
      <p>We elevated our lo-fi flows into polished, pixel-accurate screens grounded in our design system.</p>
    </div>
    <div class="phase-card reveal reveal-delay-2">
      <div class="phase-number">02</div>
      <h3>A/B Testing</h3>
      <p>We ran 11 A/B tests to validate layout, navigation, and interaction decisions with real users.</p>
    </div>
    <div class="phase-card reveal reveal-delay-3">
      <div class="phase-number">03</div>
      <h3>Prototyping</h3>
      <p>We connected our hi-fi screens into interactive prototypes to demonstrate the redesigned end-to-end flow.</p>
    </div>
  </div>
  <p class="back-note reveal reveal-delay-4">Let's go back to the beginning of April&hellip;</p>
</section>

