          <svg width="25" height="25" viewBox="0 0 25 25" fill="none"><path d="M6 17h13M7.5 17V11a5 5 0 0110 0v6M10 20a2.5 2.5 0 005 0" stroke="#71767B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span style="font-size:10px;color:#71767B;font-family:Inter,sans-serif;">Notifications</span>
        </div>
